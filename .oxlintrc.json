{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "import", "jsx-a11y", "nextjs", "oxc"],
	"ignorePatterns": [
		"**/.content-collections/**",
		"**/.next/**",
		"**/.source/**",
		"**/coverage/**",
		"**/dist/**",
		"**/lib/db/migrations/**",
		"**/node_modules/**",
		"**/playwright-report/**",
		"**/test-results/**",
		"next-env.d.ts"
	],
	"options": {
		"denyWarnings": true,
		"typeAware": true
	},
	"rules": {
		"jsx-a11y/prefer-tag-over-role": "off"
	},
	"overrides": [
		{
			"files": ["components/marketing/sections/contact-section.tsx"],
			"rules": {
				"jsx-a11y/autocomplete-valid": "off"
			}
		},
		{
			"files": ["components/ui/custom/input-number.tsx"],
			"rules": {
				"jsx-a11y/role-supports-aria-props": "off"
			}
		},
		{
			"files": ["components/ui/pagination.tsx"],
			"rules": {
				"jsx-a11y/anchor-has-content": "off"
			}
		}
	]
}
